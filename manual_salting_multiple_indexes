import pyspark.sql.functions as F

salt_bins = 10
# Define all your massive, skewed keys in a single list
skewed_keys = ["HOSPITAL_A", "HOSPITAL_B", "FACTORY_1"] 

# 1. Salt the Fact Table (Apply to any key in the list)
fact_salted = df_fact.withColumn(
    "join_key",
    F.when(
        F.col("asset_id").isin(skewed_keys), 
        F.concat(F.col("asset_id"), F.lit("_"), F.floor(F.rand() * salt_bins).cast("string"))
    ).otherwise(F.col("asset_id"))
)

# 2. Explode the Dimension Table
# Isolate the skewed rows using .isin()
dim_skewed = df_dim.filter(F.col("asset_id").isin(skewed_keys)) \
    .withColumn("salt_array", F.array([F.lit(i) for i in range(salt_bins)])) \
    .withColumn("salt_val", F.explode("salt_array")) \
    .withColumn("join_key", F.concat(F.col("asset_id"), F.lit("_"), F.col("salt_val").cast("string"))) \
    .drop("salt_array", "salt_val")

# Isolate the normal rows using the NOT operator (~)
dim_normal = df_dim.filter(~F.col("asset_id").isin(skewed_keys)) \
    .withColumn("join_key", F.col("asset_id"))

# Union them back together
dim_salted = dim_skewed.unionByName(dim_normal)

# 3. Perform the optimized join on the new salted keys
final_df = fact_salted.join(dim_salted, on="join_key", how="left")
